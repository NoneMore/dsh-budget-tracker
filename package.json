{
  "name": "dsh-budget-tracker",
  "version": "0.2.3",
  "description": "DeepSeek Harness budget tracker exposing remaining pressure budget before proactive compaction.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check client.js && node --test"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "agent",
    "compaction",
    "context-window",
    "budget-tracker"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoneMore/dsh-budget-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/NoneMore/dsh-budget-tracker/issues"
  },
  "homepage": "https://github.com/NoneMore/dsh-budget-tracker#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
